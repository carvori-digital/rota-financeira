{
  "name": "rota-financeira",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:db && npm run test:ui",
    "test:isolation": "node scripts/test-isolation.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 42817 --strictPort",
    "test:db": "node --test tests/database.test.mjs tests/planning-database.test.mjs tests/consolidation-database.test.mjs tests/record-management.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "format": "prettier --write .",
    "test:unit": "node --experimental-strip-types --test tests/finance.test.ts tests/planning.test.ts tests/pwa.test.ts tests/experience.test.ts tests/consolidation.test.ts",
    "test:live": "node --experimental-strip-types scripts/test-live.mjs",
    "test:mobile": "node scripts/test-mobile.mjs",
    "validate:remote-data": "node scripts/remote-baseline.mjs",
    "validate:experience-data": "node scripts/experience-data-audit.mjs",
    "preview:experience": "node scripts/experience-preview.mjs",
    "test:experience": "node scripts/test-experience.mjs",
    "snapshot:records": "node --experimental-strip-types scripts/snapshot-consolidation.mjs",
    "audit:records": "node scripts/record-management-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^1.50.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.35.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
